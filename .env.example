# Copy to .env.local for local development, and configure the same keys
# in the Hostinger Node.js App environment-variables panel for staging/production.
# Never commit .env, .env.local or .env.production.

# --- Site ---
# Set to "true" on the staging domain to force noindex + a staging robots.txt.
# Leave unset (or "false") on production (arjunprashanth.com).
NEXT_PUBLIC_IS_STAGING=true
NEXT_PUBLIC_SITE_URL=https://paleturquoise-sandpiper-308359.hostingersite.com

# --- Outbound email (contact + screenwriting enquiry forms) ---
# Any standard SMTP provider (Hostinger email, SendGrid, Resend SMTP, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Arjun Prashanth Website <no-reply@arjunprashanth.com>"

# Real, verified public inboxes (do not invent addresses here).
CONTACT_FORM_TO_EMAIL=filmmaker@arjunprashanth.com
SCREENWRITING_FORM_TO_EMAIL=filmmaker@arjunprashanth.com

# --- Spam protection (Cloudflare Turnstile) ---
# The production Privacy Policy already discloses Turnstile as the spam-protection
# service for the contact form, so this is the CAPTCHA provider to configure.
# Leave both blank to fall back to honeypot + timing + rate-limit checks only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin panel (/admin) ---
# Signs the admin session cookie (JWT). Generate with: openssl rand -hex 32
# Rotating this invalidates every existing admin session.
ADMIN_SESSION_SECRET=

# --- Ecommerce (books) + CMS ---
# Do not flip these on, and do not claim checkout/shipping is live, until real
# credentials are configured and verified end-to-end.

# Database (dedicated MySQL database — do not reuse the WordPress DB). Backs
# both the books/CMS admin and orders.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Razorpay: both server-only. The Key ID is handed to the browser via the
# /api/orders/create response at checkout time, not baked in at build time,
# so no NEXT_PUBLIC_* variant is needed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard > Settings > Webhooks, when registering
# https://arjunprashanth.com/api/webhooks/razorpay for the payment.captured event.
RAZORPAY_WEBHOOK_SECRET=

SHIPROCKET_EMAIL=
# Base64-encoded password (SHIPROCKET_PASSWORD_B64), not plain text — the
# password commonly contains characters (`$`, `!`, `&`, ...) that Apache's
# .htaccess SetEnv parsing has been observed to silently drop the whole
# directive for. Encode with: printf '%s' 'the-password' | base64
# A plain SHIPROCKET_PASSWORD is still read as a fallback for local dev.
SHIPROCKET_PASSWORD_B64=
# The pickup address "nickname" configured in Shiprocket under
# Settings > Pickup Addresses.
SHIPROCKET_PICKUP_LOCATION=
# Shared secret sent as the "x-api-key" header on Shiprocket's shipment/
# tracking webhook. Configure the same value under Shiprocket > Settings >
# API > Webhooks when registering
# https://arjunprashanth.com/api/webhooks/shiprocket
SHIPROCKET_WEBHOOK_SECRET=

# Where new-order notifications are sent. Falls back to CONTACT_FORM_TO_EMAIL,
# then the site's default contact address, if unset.
ORDER_NOTIFICATION_EMAIL=
